# =============================================================================
# Coturn TURN Server Configuration — OurSpace
# =============================================================================
# Place at: /etc/turnserver.conf
# Start:    turnserver -c /etc/turnserver.conf
# Systemd:  systemctl enable coturn && systemctl start coturn
#
# Compatibility: Coturn 4.5+ (Ubuntu 22.04: apt install coturn)
# =============================================================================

# ---------------------------------------------------------------------------
# Network Binding
# ---------------------------------------------------------------------------
# Replace YOUR_SERVER_PUBLIC_IP with the actual server public IPv4 address.
# Required for correct relay candidate generation.
listening-ip=YOUR_SERVER_PUBLIC_IP
relay-ip=YOUR_SERVER_PUBLIC_IP

# Replace with your TURN server's public DNS hostname
realm=turn.yourserver.com
server-name=turn.yourserver.com

# ---------------------------------------------------------------------------
# Listening Ports
# ---------------------------------------------------------------------------
# Standard TURN / STUN port (UDP + TCP)
listening-port=3478

# TURNS (TLS) port — requires certificates
tls-listening-port=5349

# ---------------------------------------------------------------------------
# Relay Port Range (UDP)
# The firewall must allow inbound UDP traffic on this entire range.
# Allocate generously for concurrent WebRTC sessions.
# Each WebRTC connection uses 2 relay ports (one per direction).
# 100 ports = ~50 concurrent sessions
# ---------------------------------------------------------------------------
min-port=49152
max-port=65535

# ---------------------------------------------------------------------------
# TLS Certificates (required for turns: connections)
# Generate with: certbot certonly --standalone -d turn.yourserver.com
# ---------------------------------------------------------------------------
cert=/etc/letsencrypt/live/turn.yourserver.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.yourserver.com/privkey.pem

# ---------------------------------------------------------------------------
# HMAC Authentication (matches backend TURN_SECRET)
# This is the shared secret used to verify time-limited credentials.
# MUST match the TURN_SECRET environment variable on the backend.
#
# Credential format (generated by backend):
#   username  = "<unix_expiry_timestamp>:<userId>"
#   password  = HMAC-SHA1(TURN_SECRET, username) encoded as base64
# ---------------------------------------------------------------------------
use-auth-secret
static-auth-secret=REPLACE_WITH_SAME_VALUE_AS_TURN_SECRET_ENV_VAR

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# CRITICAL: Disable anonymous relay — require authentication for all clients
no-auth=0

# Reject traffic to internal/private IP ranges (prevents SSRF via TURN)
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Disable non-WebRTC relay mechanisms (security hardening)
no-multicast-peers
no-loopback-peers

# ---------------------------------------------------------------------------
# Logging
# Do NOT log client credentials or auth tokens.
# ---------------------------------------------------------------------------
log-file=/var/log/coturn/turnserver.log
syslog
no-stdout-log

# Log level (0=verbose, 1=DTLS debug, 3=info, 5=errors only)
Verbose=3

# ---------------------------------------------------------------------------
# Performance
# ---------------------------------------------------------------------------
# Number of server threads (set to number of CPU cores)
proc-user=turnserver
proc-group=turnserver

# Maximum number of sessions per user
user-quota=100

# Maximum number of total relay sessions
total-quota=1000

# Maximum bandwidth per session (in bytes/sec, 0 = unlimited)
max-bps=0

# ---------------------------------------------------------------------------
# Fingerprinting (recommended for NAT traversal)
# ---------------------------------------------------------------------------
fingerprint
