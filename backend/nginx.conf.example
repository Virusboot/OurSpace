# =============================================================================
# Nginx Reverse Proxy Configuration — OurSpace Backend
# =============================================================================
# Place this file at: /etc/nginx/sites-available/ourspace
# Enable with:  ln -s /etc/nginx/sites-available/ourspace /etc/nginx/sites-enabled/
# Reload with:  nginx -t && systemctl reload nginx
#
# Prerequisites:
#   - SSL certificates via Let's Encrypt: certbot --nginx -d api.yourserver.com
#   - Node.js backend running on localhost:4000
# =============================================================================

# Upstream backend server
upstream ourspace_backend {
    server 127.0.0.1:4000;
    keepalive 64;
}

# ---------------------------------------------------------------------------
# HTTP → HTTPS redirect
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name api.yourserver.com;

    # Allow Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all HTTP to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# HTTPS Server — REST API + WebSocket (WSS)
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.yourserver.com;

    # ---------------------------------------------------------------------------
    # SSL Certificates (generated by certbot)
    # ---------------------------------------------------------------------------
    ssl_certificate     /etc/letsencrypt/live/api.yourserver.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.yourserver.com/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_stapling              on;
    ssl_stapling_verify       on;

    # ---------------------------------------------------------------------------
    # Security Headers
    # ---------------------------------------------------------------------------
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff"                             always;
    add_header X-Frame-Options           "DENY"                                always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"     always;

    # ---------------------------------------------------------------------------
    # Request limits
    # ---------------------------------------------------------------------------
    client_max_body_size 15m;         # Allow media uploads up to 15MB
    client_body_timeout  30s;
    client_header_timeout 30s;

    # ---------------------------------------------------------------------------
    # WebSocket Upgrade — WSS (/ws endpoint)
    # Long-lived connections: disable proxy_read_timeout for WS
    # ---------------------------------------------------------------------------
    location /ws {
        proxy_pass         http://ourspace_backend;
        proxy_http_version 1.1;

        # CRITICAL: preserve Upgrade and Connection headers for WebSocket
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Forward real client IP
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long timeout for persistent WebSocket connections
        # Do NOT set short timeouts here — they will terminate active calls and chats
        proxy_read_timeout   86400s;   # 24 hours — connection kept alive by WS ping/pong
        proxy_send_timeout   86400s;
        proxy_connect_timeout   10s;

        # Disable buffering for real-time streaming
        proxy_buffering off;
    }

    # ---------------------------------------------------------------------------
    # REST API
    # ---------------------------------------------------------------------------
    location /api/ {
        proxy_pass         http://ourspace_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";   # Disable keep-alive upgrade for REST

        # Reasonable timeouts for API calls
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;
        proxy_connect_timeout 10s;

        proxy_buffering on;
        proxy_buffer_size 4k;
    }

    # ---------------------------------------------------------------------------
    # Health / Readiness endpoints (no auth required)
    # ---------------------------------------------------------------------------
    location ~ ^/(health|ready)$ {
        proxy_pass         http://ourspace_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 5s;
        proxy_connect_timeout 5s;
        access_log off;            # Reduce log noise from health check pings
    }

    # ---------------------------------------------------------------------------
    # Static downloads (public directory)
    # ---------------------------------------------------------------------------
    location /downloads/ {
        proxy_pass http://ourspace_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    # Block access to sensitive paths
    location ~ /\. {
        deny all;
    }
}
