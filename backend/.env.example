# =============================================================================
# OurSpace Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to Git.
# NEVER use development fallback values in production.
# All secrets must be cryptographically random and ≥ 32 characters.
# =============================================================================

# ---------------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# ---------------------------------------------------------------------------
# DATABASE (REQUIRED)
# Backend will REFUSE to start if DATABASE_URL is missing in production.
# Use a managed PostgreSQL service (Supabase, Render PG, AWS RDS, etc.)
# Ensure SSL is enabled for all remote connections.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require

# ---------------------------------------------------------------------------
# AUTHENTICATION (REQUIRED)
# Must be a cryptographically random secret ≥ 32 characters.
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET_MIN_32_CHARS

# ---------------------------------------------------------------------------
# CORS (REQUIRED in production)
# Set to your exact frontend origin(s). Do NOT use * in production.
# For multiple origins: https://app.ourspace.app,https://www.ourspace.app
# ---------------------------------------------------------------------------
CORS_ORIGIN=https://YOUR_FRONTEND_DOMAIN.com

# ---------------------------------------------------------------------------
# TURN / COTURN SERVER (REQUIRED for WebRTC relay)
# TURN_SECRET must match the static-auth-secret in your coturn config.
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
TURN_URL=turn:YOUR_TURN_SERVER_HOSTNAME:3478
TURN_URL_TLS=turns:YOUR_TURN_SERVER_HOSTNAME:5349
TURN_SECRET=REPLACE_WITH_SHARED_COTURN_HMAC_SECRET

# ---------------------------------------------------------------------------
# REDIS (OPTIONAL — falls back to in-memory if not set)
# Redis is recommended in production for session caching.
# For Render/Railway Redis: redis://default:PASSWORD@HOST:6379
# ---------------------------------------------------------------------------
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# ---------------------------------------------------------------------------
# OPTIONAL OVERRIDES
# Used for testing or specific deployment environments.
# ---------------------------------------------------------------------------
# TURN_USERNAME=   # Only set for static credential TURN (not HMAC-mode)
# TURN_CREDENTIAL= # Only set for static credential TURN (not HMAC-mode)
